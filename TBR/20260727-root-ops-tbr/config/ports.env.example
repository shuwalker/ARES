# ARES local port configuration
#
# Copy these entries to the repository-root .env to override them.
# Production applications must not use the automated-test range.
# Hermes ports are intentionally absent: they are owned and configured by
# the separate Hermes project.

# Dedicated ARES browser/native-shell backend.
ARES_WEBUI_HOST=127.0.0.1
ARES_WEBUI_PORT=8788

# Pytest derives a stable per-worktree port within this range.
ARES_TEST_PORT_RANGE=20000-29999
